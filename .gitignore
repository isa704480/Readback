__pycache__/
*.py[cod]
*.bak
.venv/
venv/
.env
# The database and both of its sidecars. `*.db` alone does not match
# `readback.db-wal`, and the write-ahead log holds the same capture rows the
# database file does -- it was 1.6 MB of them when this was noticed. Ignoring the
# database but committing its journal is the same mistake with an extra step.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
node_modules/
dist/
.DS_Store
.pytest_cache/
.ruff_cache/
