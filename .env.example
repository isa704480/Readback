# Readback -- every server setting, one line each, no real values.
# Copy to .env for local development; server/config.py reads it with the
# READBACK_ prefix. In production these are set in the Render dashboard
# (render.yaml), never in a file. The browser variable is separate and lives in
# web/.env.example (VITE_READBACK_API).

# ---------------------------------------------------------------- the seam --
# The AssemblyAI key. Empty = every session replays a recorded fixture; set =
# live sockets may open. Held by the server only; the browser never gets it.
READBACK_ASSEMBLYAI_API_KEY=
# The streaming endpoint. Only change to point at a mock during development.
READBACK_ASSEMBLYAI_URL=wss://streaming.assemblyai.com/v3/ws

# ---------------------------------------------------------- the kill switch --
# true = read recorded Turn frames from disk instead of opening a socket, even
# when a key is present. This is how all spend is stopped in one edit.
READBACK_REPLAY_MODE=false
# Declared in config.py but not read by the server today: fixtures are located
# from the package (server/stream/replay.py -> tests/fixtures). Left at default.
READBACK_REPLAY_FIXTURE_DIR=tests/fixtures/turns

# --------------------------------------------------------------- the money --
# Socket-seconds allowed per UTC day across all sessions ($0.60/hr/socket).
# Code default 120000 = $20/day; render.yaml deploys 36000 = $6/day.
READBACK_DAILY_BUDGET_SECONDS=120000
# Fraction of the daily budget at which a BUDGET_ALARM audit row is written.
READBACK_BUDGET_ALARM_FRACTION=0.60
# Hard cap on one session's socket-open time, enforced server-side.
READBACK_SESSION_CAP_SECONDS=150
# Sockets an A/B demo session opens (1 or 2); the budget counts both.
READBACK_DEMO_SOCKETS=2

# ------------------------------------------------------- admission control --
# Sessions one (salted, hashed) address may start per hour and per day.
READBACK_PER_IP_PER_HOUR=3
READBACK_PER_IP_PER_DAY=10
# Pipelines allowed to run at once; the next caller gets a 503 + Retry-After.
READBACK_MAX_CONCURRENT_SESSIONS=3
# New sessions admitted per minute, globally.
READBACK_ADMISSIONS_PER_MINUTE=2

# ------------------------------------------------------------- the consent --
# Always true. config.py refuses false unless REPLAY_MODE is also true. Listed
# so nobody has to wonder whether the toggle exists; do not set it to false.
READBACK_CONSENT_REQUIRED=true
# Version stamp of the disclosure text the person accepted; stored per session.
READBACK_CONSENT_VERSION=2026-09-01

# --------------------------------------------------------------- retention --
# Days a capture row is kept before the purge removes it.
READBACK_CAPTURE_RETENTION_DAYS=30
# Days a question event is kept.
READBACK_QUESTION_RETENTION_DAYS=7
# Hours a session's salted IP hash is kept.
READBACK_IP_HASH_RETENTION_HOURS=24
# Hours a demo-mode session survives before auto-purge (ARCH 3.12).
READBACK_DEMO_PURGE_HOURS=24

# ----------------------------------------------------------------- secrets --
# Salt for the per-IP hash so a repeat visitor is countable without being
# identifiable. Commented out, not blank: a blank value is read as "" and is
# NOT the dev placeholder. Unset = placeholder, which config.py refuses next to
# a real key and a non-SQLite database (empty is refused the same way).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# READBACK_IP_HASH_SALT=
# HMAC key for session tokens. Same rule and same generator as above; changing
# it signs everybody out.
# READBACK_SESSION_SECRET=
# Hours a sign-in token stays valid.
READBACK_SESSION_TTL_HOURS=720

# ---------------------------------------------------------------- the web --
# Browser origins allowed to call the API, comma-separated, scheme included,
# no trailing slash. Production: the Vercel domain. Not applied to WebSockets.
READBACK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------ the db --
# SQLite file for a laptop; a postgres:// URL in production (server/db.py
# rewrites the scheme to the psycopg 3 driver).
READBACK_DATABASE_URL=sqlite:///./readback.db
# true = log every SQL statement. Noisy; development only.
READBACK_SQL_ECHO=false

# DEBUG | INFO | WARNING | ERROR
READBACK_LOG_LEVEL=INFO
